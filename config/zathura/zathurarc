set guioptions none
set font "JetBrainsMonoNerdFont 15"
set page-v-padding 15
set adjust-open "best-fit"
set selection-clipboard clipboard
set selection-notification false

map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map b toggle_statusbar
map i recolor
map f toggle_fullscreen
map h navigate previous
map l navigate next
map [fullscreen] f toggle_fullscreen

set statusbar-home-tilde     true
set statusbar-basename       true
set window-title-home-tilde  true
set window-title-basename    true

# zathurarc-catppuccin
set notification-error-bg "#F28FAD"
set notification-error-fg "#1f2029"
set notification-warning-bg "#FAE3B0"
set notification-warning-fg "#1f2029"
set notification-bg "#EBDDAA"
set notification-fg "#1f2029"

set completion-group-bg "#1f2029"
set completion-group-fg "#EBDDAA"
set completion-bg "#1f2029"
set completion-fg "#d8dceb"
set completion-highlight-bg "#46405A"
set completion-highlight-fg "#d8dceb"

# Define the color in index mode
set index-bg rgba(31,32,41,0.8)
set index-fg "#d8dceb"
set index-active-bg "#46405A"
set index-active-fg "#EBDDAA"

set inputbar-bg "#46405A"
set inputbar-fg "#EBDDAA"

set statusbar-bg rgba(11,12,16,0.3)
set statusbar-fg "#d8dceb"

set highlight-color "rgba(137, 180, 250, 0.35)"
set highlight-active-color "rgba(242, 143, 173, 0.5)"

set default-bg rgba(31,32,41,0.8)
set default-fg "#d8dceb"
set render-loading true
set render-loading-fg "#1f2029"
set render-loading-bg rgba(31,32,41,0.8)

# Recolor book content's color
set recolor true
set recolor-lightcolor rgba(11,12,16,0.3)
set recolor-darkcolor "#d8dceb"
set recolor-keephue true
