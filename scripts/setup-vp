#!/usr/bin/env fish

set file_name "vp-x86_64-unknown-linux-gnu.tar.gz"
set url "https://api.github.com/repos/voidzero-dev/vite-plus/releases/latest"
set target (curl -s "$url" | grep "browser_download_url" \
	| cut -d '"' -f 4 | grep "$file_name")

command curl -L -o "$file_name" "$target"

command mkdir -p /tmp/vp
command tar xzf "$file_name" -C /tmp/vp
command rm -rf $file_name

/tmp/vp/vp setup

echo "done"
